# Copy to .env and fill in.

# --- Claude ---------------------------------------------------------------
# Optional if you've run `ant auth login` — a zero-arg SDK client picks up the
# stored profile automatically.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Diarization ----------------------------------------------------------
# Required. Accept the gated-model conditions first:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HUGGINGFACE_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# --- ASR ------------------------------------------------------------------
# auto = mlx on Apple Silicon (Metal), faster_whisper (CPU) everywhere else.
ASR_BACKEND=auto
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
FASTER_WHISPER_MODEL=large-v3-turbo
# CPU threads for faster-whisper. Empty = all cores.
CPU_THREADS=

# --- Capture --------------------------------------------------------------
# Seconds per live-transcription segment.
SEGMENT_SECONDS=15
# Your name, used to label the mic channel in dual-channel recordings.
MY_NAME=Me
# Set true for in-person meetings where several people share one mic.
DIARIZE_MIC_CHANNEL=false

# --- Delivery -------------------------------------------------------------
# Connect this folder to a claude.ai Project as project knowledge.
# Empty = ~/Google Drive/My Drive/TranscribeMe on macOS, G:/My Drive/TranscribeMe
# on Windows. Delivery is skipped (with a warning) if the parent doesn't exist.
DRIVE_DIR=

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
